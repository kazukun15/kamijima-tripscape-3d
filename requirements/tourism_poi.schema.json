{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kamijima Tourism POI",
  "type": "object",
  "required": [
    "id",
    "name",
    "island",
    "categories",
    "coordinates",
    "verification_status",
    "source_urls",
    "last_verified_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "name_kana": {
      "type": "string"
    },
    "island": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordinates": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lng": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "coordinate_source": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "official_verified",
        "multi_source_verified",
        "coordinate_verified",
        "approximate_area_only",
        "pending",
        "rejected"
      ]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "history": {
      "type": "string"
    },
    "culture": {
      "type": "string"
    },
    "nature": {
      "type": "string"
    },
    "best_season": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "best_time": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access": {
      "type": "object"
    },
    "official_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified_at": {
      "type": "string"
    },
    "related_pois": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_people": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}